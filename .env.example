# =============================================================================
# Premium Poultry Farm - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND (FastAPI + AstraDB) - Database & Authentication
# -----------------------------------------------------------------------------

# AstraDB Connection (DataStax Astra)
# Get these from: https://astra.datastax.com/ -> Your Database -> Settings -> Database Details
ASTRA_DB_API_ENDPOINT=https://your-database-id-your-region.apps.astra.datastax.com
ASTRA_DB_TOKEN=AstraCS:REDACTED-token-here
# REQUIRED. The Data API is keyspace-scoped, so without this every request 404s
# and the app looks empty. Find it in the AstraDB console under your keyspace,
# or run: astra create-keyspace <name>
ASTRA_DB_KEYSPACE=your_keyspace_name

# JWT Authentication Secret
# IMPORTANT: Change this to a strong random string in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# -----------------------------------------------------------------------------
# WEB PUSH NOTIFICATIONS (VAPID)
# Generate a pair with:
#   python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.private_pem())"
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@example.com
VAPID_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# FRONTEND (Vite + React) - API Configuration
# -----------------------------------------------------------------------------

# API Base URL (used by frontend to call backend)
# In development with Vite proxy: '/api' (proxied to http://localhost:8080)
# In production: 'https://your-api-domain.com/api'
VITE_API_URL=/api

# -----------------------------------------------------------------------------
# OPTIONAL: Additional Services (add as needed)
# -----------------------------------------------------------------------------

# Email Service (e.g., SendGrid, Mailgun, AWS SES)
# EMAIL_API_KEY=
# EMAIL_FROM=noreply@yourdomain.com

# Payment Gateway (e.g., Stripe, PayPal)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# File Storage (e.g., AWS S3, Cloudinary)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=

# Monitoring & Logging (e.g., Sentry, Datadog)
# SENTRY_DSN=

# -----------------------------------------------------------------------------
# DEVELOPMENT OVERRIDES (only used in local development)
# -----------------------------------------------------------------------------

# Backend server
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8080

# Frontend dev server
# FRONTEND_PORT=5173

# Debug mode
# DEBUG=true
# LOG_LEVEL=debug